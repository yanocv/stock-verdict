# Anthropic API key for the AI verdict summary. Optional: without it the
# app still works and the AI narrative is skipped.
ANTHROPIC_API_KEY=

# Claude model used for the AI summary. Defaults to claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- AI company research (docs/CALCULATIONS.md §9) ---
# Uses ANTHROPIC_API_KEY above; off without it. Billed per use on the Claude API
# (platform.claude.com), separate from a claude.ai subscription.
# RESEARCH_ENABLED=true
# RESEARCH_MODEL=claude-opus-5-5
# Budget guard (USD), checked before every call:
# RESEARCH_DAILY_BUDGET_USD=1
# RESEARCH_MONTHLY_BUDGET_USD=10
# RESEARCH_DAILY_MAX_CALLS=20
# Reuse saved research for this many days:
# RESEARCH_MAX_AGE_DAYS=7
# How long a page waits for new research before showing it on the next load (ms):
# RESEARCH_WAIT_MS=45000

# --- Database (verdict log, research cache, API usage) ---
# KABUCHECK_DB_PATH=data/kabucheck.db
# VERDICT_LOG_ENABLED=true
